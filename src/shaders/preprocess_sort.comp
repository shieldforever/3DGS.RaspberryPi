#version 450
#extension GL_GOOGLE_include_directive : enable
#include "./common.glsl"

// 移除 64 位整型扩展，树莓派不支持
// #extension GL_EXT_shader_explicit_arithmetic_types_int64 : enable

layout (std430, set = 0, binding = 0) readonly buffer Vertices {
    VertexAttribute attr[];
};

layout (std430, set = 0, binding = 1) readonly buffer In {
    uint prefixSum[];
};

// 拆分为两个 32 位缓冲区输出
layout (std430, set = 0, binding = 2) writeonly buffer OutKeysLow {
    uint keys_low[];
};

layout (std430, set = 0, binding = 4) writeonly buffer OutKeysHigh {
    uint keys_high[];
};

layout (std430, set = 0, binding = 3) writeonly buffer OutPayloads {
    uint payloads[];
};

layout( push_constant ) uniform Constants
{
    uint tileX;
    uint use_origin_intersection;
};

layout (local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

vec2 compute_ellipse_intersection(vec4 con_o, float disc, float t, vec2 p, bool is_y, float coord) {
    float p_u = is_y ? p.y : p.x;
    float p_v = is_y ? p.x : p.y;
    float coeff = is_y ? con_o.x : con_o.z;

    float h = coord - p_u;
    float sqrt_term = sqrt(disc * h * h + t * coeff);

    return vec2(
        (-con_o.y * h - sqrt_term) / coeff + p_v,
        (-con_o.y * h + sqrt_term) / coeff + p_v
    );
}

void process_tiles_emit(
    vec4 con_o,
    float disc,
    float t,
    vec2 p,
    vec2 bbox_min,
    vec2 bbox_max,
    vec2 bbox_argmin,
    vec2 bbox_argmax,
    ivec2 rect_min,
    ivec2 rect_max,
    bool is_y,
    uint gaussian_index,
    float depth,
    inout uint off
) {
    float block_u = is_y ? float(TILE_HEIGHT) : float(TILE_WIDTH);
    float block_v = is_y ? float(TILE_WIDTH) : float(TILE_HEIGHT);

    if (is_y) {
        rect_min = rect_min.yx;
        rect_max = rect_max.yx;
        bbox_min = bbox_min.yx;
        bbox_max = bbox_max.yx;
        bbox_argmin = bbox_argmin.yx;
        bbox_argmax = bbox_argmax.yx;
    }

    vec2 intersect_min_line;
    vec2 intersect_max_line = vec2(bbox_max.y, bbox_min.y);
    float ellipse_min;
    float ellipse_max;

    float min_line = float(rect_min.x) * block_u;
    if (bbox_min.x <= min_line) {
        intersect_min_line = compute_ellipse_intersection(con_o, disc, t, p, is_y, min_line);
    } else {
        intersect_min_line = intersect_max_line;
    }

    uint depthBits = floatBitsToUint(depth);
    for (int u = rect_min.x; u < rect_max.x; ++u) {
        float max_line = min_line + block_u;
        if (max_line <= bbox_max.x) {
            intersect_max_line = compute_ellipse_intersection(con_o, disc, t, p, is_y, max_line);
        }

        if (min_line <= bbox_argmin.y && bbox_argmin.y < max_line) {
            ellipse_min = bbox_min.y;
        } else {
            ellipse_min = min(intersect_min_line.x, intersect_max_line.x);
        }

        if (min_line <= bbox_argmax.y && bbox_argmax.y < max_line) {
            ellipse_max = bbox_max.y;
        } else {
            ellipse_max = max(intersect_min_line.y, intersect_max_line.y);
        }

        int min_tile_v = max(rect_min.y, min(rect_max.y, int(ellipse_min / block_v)));
        int max_tile_v = min(rect_max.y, max(rect_min.y, int(ellipse_max / block_v + 1.0)));

        for (int v = min_tile_v; v < max_tile_v; ++v) {
            uint tileIndex = is_y ? (uint(u) * tileX + uint(v)) : (uint(v) * tileX + uint(u));
            keys_high[off] = tileIndex;
            keys_low[off] = depthBits;
            payloads[off] = gaussian_index;
            off++;
        }

        intersect_min_line = intersect_max_line;
        min_line = max_line;
    }
}

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= prefixSum.length()) {
        return;
    }

    if (attr[index].color_radii.w == 0) {
        return;
    }

//    assert(
//        attr[index].aabb.x < attr[index].aabb.z && attr[index].aabb.y < attr[index].aabb.w,
//        "in!!!valid aabb: %d\n",
//        int(index)
//    );

    uint ind = index == 0 ? 0 : prefixSum[index - 1];

//    assert(attr[index].aabb.x < (800 + TILE_WIDTH - 1) / TILE_WIDTH && attr[index].aabb.y < (600 + TILE_HEIGHT - 1) / TILE_HEIGHT, "invalid aabb: %d %d %d %d\n", ivec4(attr[index].aabb));

    if (use_origin_intersection != 0u) {
        uint depthBits = floatBitsToUint(attr[index].depth);
        for (uint i = attr[index].aabb.x; i < attr[index].aabb.z; i++) {
            for (uint j = attr[index].aabb.y; j < attr[index].aabb.w; j++) {
                uint tileIndex = i + j * tileX;
                keys_high[ind] = tileIndex;
                keys_low[ind] = depthBits;
                payloads[ind] = index;
                ind++;
            }
        }
        return;
    }

    vec4 con_o = attr[index].conic_opacity;
    float disc = con_o.y * con_o.y - con_o.x * con_o.z;
    if (con_o.x <= 0.0 || con_o.z <= 0.0 || disc >= 0.0 || con_o.w <= (1.0 / 255.0)) {
        return;
    }

    float t = 2.0 * log(con_o.w * 255.0);
    vec2 p = attr[index].uv;

    float x_term = sqrt(-(con_o.y * con_o.y * t) / (disc * con_o.x));
    x_term = (con_o.y < 0.0) ? x_term : -x_term;
    float y_term = sqrt(-(con_o.y * con_o.y * t) / (disc * con_o.z));
    y_term = (con_o.y < 0.0) ? y_term : -y_term;

    vec2 bbox_argmin = vec2(p.y - y_term, p.x - x_term);
    vec2 bbox_argmax = vec2(p.y + y_term, p.x + x_term);
    vec2 bbox_min = vec2(
        compute_ellipse_intersection(con_o, disc, t, p, true, bbox_argmin.x).x,
        compute_ellipse_intersection(con_o, disc, t, p, false, bbox_argmin.y).x
    );
    vec2 bbox_max = vec2(
        compute_ellipse_intersection(con_o, disc, t, p, true, bbox_argmax.x).y,
        compute_ellipse_intersection(con_o, disc, t, p, false, bbox_argmax.y).y
    );

    ivec2 rect_min = ivec2(attr[index].aabb.xy);
    ivec2 rect_max = ivec2(attr[index].aabb.zw);
    if ((rect_max.x - rect_min.x) * (rect_max.y - rect_min.y) == 0) {
        return;
    }

    bool is_y = (rect_max.y - rect_min.y) < (rect_max.x - rect_min.x);
    process_tiles_emit(
        con_o,
        disc,
        t,
        p,
        bbox_min,
        bbox_max,
        bbox_argmin,
        bbox_argmax,
        rect_min,
        rect_max,
        is_y,
        index,
        attr[index].depth,
        ind
    );

    // assert(ind == prefixSum[index], "ind: %d", ind);
}
